# Copie para .env e preencha os valores reais (nunca commite o .env)
# cp .env.example .env

# Banco local (compose). A API dentro do compose usa host "db" automaticamente.
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Para usar o Neon em vez do Postgres local, descomente e preencha:
# DB_URL=jdbc:postgresql://ep-xxxx-xxxx.us-east-2.aws.neon.tech/aceleraflix?sslmode=require
# (suba só a API, sem o banco local: docker compose up --build --no-deps api)

# Segredo HMAC do JWT (mínimo 32 chars aleatórios). Gere com: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-forte-de-32-chars

# YouTube Data API v3 (opcional p/ subir; obrigatória p/ cadastrar vídeos)
YOUTUBE_API_KEY=

# Opcionais
SERVER_PORT=8080
ALLOWED_ORIGINS=http://localhost:5173
SPRINGDOC_ENABLED=true

# Cotas separadas com reposição gradual de tokens (por IP).
RATE_LIMIT_READ_PER_MINUTE=360
RATE_LIMIT_WRITE_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_REFRESH_PER_MINUTE=60
# Ative somente atrás de um proxy confiável que substitua X-Forwarded-For.
RATE_LIMIT_TRUST_FORWARDED_FOR=false
